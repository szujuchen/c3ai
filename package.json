{
  "name": "crunch-calendar",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend",
    "test:ui": "npm run test:ui -w frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.0"
  }
}
