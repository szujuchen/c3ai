# Copy to backend/.env (git-ignored) and fill in. Variables already set in the environment win over this file.

# Your Canvas personal access token (Canvas -> Account -> Settings -> New Access Token).
# Stays on the server: it is never sent to the browser, put in a response, or logged.
CANVA_TOKEN=

# Optional. Require a password to log in as a role (set at least the admin one before others can reach the server).
# LOGIN_PASSWORD_ADMIN=
# LOGIN_PASSWORD_HOST=
# LOGIN_PASSWORD_STUDENT=
# SESSION_HOURS=12
# PORT=3001
# CANVAS_BASE_URL=https://canvas.cmu.edu
# CORS_ORIGIN=
